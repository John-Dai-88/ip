<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="655.0" prefWidth="670.0"
            style="-fx-background-color: #f0f0f0;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jarvis.ui.JarvisGuiController">

    <children>
        <!-- Chat Display Area -->
        <ScrollPane fx:id="scrollPane"
                    layoutX="11.0"
                    layoutY="10.0"
                    prefHeight="582.0"
                    prefWidth="647.0"
                    style="-fx-background: #f0f0f0; -fx-background-color: #f0f0f0; -fx-border-color: #d0d0d0; -fx-border-radius: 10; -fx-background-radius: 10;">
            <content>
                <VBox fx:id="dialogContainer"
                      prefHeight="493.0"
                      prefWidth="645.0"
                      style="-fx-background-color: #f0f0f0; -fx-padding: 10;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Input Area -->
        <HBox layoutX="14.0" layoutY="598.0" spacing="10.0" prefHeight="42.0" prefWidth="644.0">
            <children>
                <TextField fx:id="userInput"
                           prefHeight="42.0"
                           prefWidth="524.0"
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 10; -fx-border-color: #d0d0d0; -fx-background-color: white; -fx-font-size: 13px;" />
                <Button fx:id="sendButton"
                        prefHeight="42.0"
                        prefWidth="115.0"
                        text="Send"
                        style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</AnchorPane>