<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="jarvis.ui.JarvisGuiController"
        prefHeight="655.0"
        prefWidth="670.0"
        styleClass="chat-root">

    <children>

        <!-- ========================= -->
        <!-- Chat display area          -->
        <!-- ========================= -->

        <ScrollPane
                fx:id="scrollPane"
                hbarPolicy="NEVER"
                fitToWidth="true"
                fitToHeight="true"
                AnchorPane.topAnchor="10.0"
                AnchorPane.leftAnchor="10.0"
                AnchorPane.rightAnchor="10.0"
                AnchorPane.bottomAnchor="62.0"
                styleClass="chat-scroll-pane">

            <content>

                <VBox
                        fx:id="dialogContainer"
                        fillWidth="true"
                        spacing="2.0"
                        styleClass="dialog-container">

                    <padding>
                        <Insets
                                top="10.0"
                                right="10.0"
                                bottom="10.0"
                                left="10.0"/>
                    </padding>

                </VBox>

            </content>

        </ScrollPane>


        <!-- ========================= -->
        <!-- Input area                -->
        <!-- ========================= -->

        <HBox
                spacing="10.0"
                alignment="CENTER"
                AnchorPane.leftAnchor="10.0"
                AnchorPane.rightAnchor="10.0"
                AnchorPane.bottomAnchor="10.0"
                prefHeight="42.0"
                styleClass="input-container">

            <children>

                <TextField
                        fx:id="userInput"
                        HBox.hgrow="ALWAYS"
                        prefHeight="42.0"
                        promptText="Type a message..."
                        onAction="#handleUserInput"
                        styleClass="user-input"/>

                <Button
                        fx:id="sendButton"
                        prefWidth="115.0"
                        prefHeight="42.0"
                        text="Send"
                        onAction="#handleUserInput"
                        styleClass="send-button"/>

            </children>

        </HBox>

    </children>

</AnchorPane>
